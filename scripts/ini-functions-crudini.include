#!/bin/sh

############################
# FILENAME FUNCTIONS
############################

CRUDINI_OPTIONS="--ini-options=ignoreindent"

filename(){
        local FILENAME=$(basename "$1")
        echo "${FILENAME%.*}"
}

extname(){
        local FILENAME=$(basename "$1")
        local EXTNAME="${FILENAME##*.}"
        #
        if [ "$FILENAME" = "$EXTNAME" ]; then
                echo ""
        else
                echo "$EXTNAME"
        fi
}

############################
# INI FUNCTIONS
############################

ini_valid(){
	local SOURCE="$1"
	local SECTIONS=""
	local RESULT=""
	# save sections to file
	if ! crudini --get $CRUDINI_OPTIONS "$SOURCE" > /tmp/sections.txt 2> /dev/null; then
		RESULT="error"
	else
		# check sections
		while IFS= read -r CURR ; do
			if [ -n "$RESULT" ]; then
				: # HAS ERROR
			elif ! crudini --get $CRUDINI_OPTIONS "$SOURCE" "$CURR" > /dev/null 2>&1; then
				RESULT="error"
			fi
		done < /tmp/sections.txt
	fi
	#
	if [ -n "$RESULT" ]; then
		return 1
	else
		return 0
	fi
}

ini_list_sections(){
	local SOURCE="$1"
	crudini --get $CRUDINI_OPTIONS "$SOURCE" 2> /dev/null
}

ini_has_section(){
	local SOURCE="$1"
	local SECTION="$2"
	#
	if crudini --get $CRUDINI_OPTIONS "$SOURCE" | grep "$SECTION" > /dev/null 2>&1; then
		return 0
	else
		return 1
	fi
}

ini_print_section(){
	local SOURCE="$1"
	local SECTION="$2"

	crudini --get $CRUDINI_OPTIONS --format=ini "$SOURCE" "$SECTION" | tail -n +2
}

ini_del_section(){
	local SOURCE="$1"
	local SECTION="$2"
	crudini --del $CRUDINI_OPTIONS "$SOURCE" "$SECTION"
}

ini_clear_section(){
	local SOURCE="$1"
	local SECTION="$2"
	# check if section exists
	if ! crudini --get $CRUDINI_OPTIONS "$SOURCE" | grep "$SECTION" > /dev/null 2>&1; then
		return 1
	fi
	# delete all keys
	ini_list_keys "$SOURCE" "$SECTION" | while IFS= read -r KEY ; do
		ini_del_key "$SOURCE" "$SECTION" "$KEY"
	done
}

ini_list_keys(){
	local SOURCE="$1"
	local SECTION="$2"
	if crudini --get $CRUDINI_OPTIONS "$SOURCE" | grep "$SECTION" > /dev/null 2>&1; then
		crudini --get $CRUDINI_OPTIONS "$SOURCE" "$SECTION"
	fi
}

ini_get_key(){
	local SOURCE="$1"
	local SECTION="$2"
	local KEY="$3"
	local DEF="$4"
	#
	if ! crudini --get $CRUDINI_OPTIONS "$SOURCE" "$SECTION" "$KEY" 2> /dev/null;	then
		echo "$DEF"
	fi
}

ini_is_key(){
	local SOURCE="$1"
	local SECTION="$2"
	local KEY="$3"
	local TEST_VALUE="$4"
	local CURR_VALUE=$(crudini --get $CRUDINI_OPTIONS "$SOURCE" "$SECTION" "$KEY" 2> /dev/null)
	#
	if [ "$TEST_VALUE" = "$CURR_VALUE" ]; then
		return 0
	else
		return 1
	fi
}

ini_set_key(){
	local SOURCE="$1"
	local SECTION="$2"
	local KEY="$3"
	local VALUE="$4"
	#
	crudini --set $CRUDINI_OPTIONS "$SOURCE" "$SECTION" "$KEY" "$VALUE"
}

ini_del_key(){
	local SOURCE="$1"
	local SECTION="$2"
	local KEY="$3"
	local VALUE="$4"
	#
	crudini --del $CRUDINI_OPTIONS "$SOURCE" "$SECTION" "$KEY"
}

ini_copy_section(){
	local FROM_FILE="$1"
	local FROM_SECTION="$2"
	local TO_FILE="$3"
	local TO_SECTION="$4"
	local EXCLUDE="$5"
	#
	if [ -f "$FROM_FILE" ] && [ -z "$EXCLUDE" ]; then
		ini_list_keys "$FROM_FILE" "$FROM_SECTION" | while IFS= read -r KEY ; do
			VALUE=$(ini_get_key "$FROM_FILE" "$FROM_SECTION" "$KEY")
			ini_set_key "$TO_FILE" "$TO_SECTION" "$KEY" "$VALUE"
		done
	elif [ -f "$FROM_FILE" ]; then
		ini_list_keys "$FROM_FILE" "$FROM_SECTION" | grep -v -E "$EXCLUDE" | while IFS= read -r KEY ; do
			VALUE=$(ini_get_key "$FROM_FILE" "$FROM_SECTION" "$KEY")
			ini_set_key "$TO_FILE" "$TO_SECTION" "$KEY" "$VALUE"
		done
	fi
}
